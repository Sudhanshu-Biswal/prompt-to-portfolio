# ── LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_INTERPRETER_MODEL=gpt-4o-mini
OPENAI_COPY_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Internal resume parsing API ───────────────────────────────
INTERNAL_RESUME_API_URL=https://internal-api.bold.com/resume
INTERNAL_RESUME_API_KEY=...

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
JOB_STATE_TTL_SECONDS=86400
JOB_STATUS_TTL_SECONDS=604800
GITHUB_CACHE_TTL_SECONDS=3600

# ── Postgres ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/portfolio_gen

# ── Object storage ────────────────────────────────────────────
S3_BUCKET=portfolio-gen-resumes
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# ── MCP servers ───────────────────────────────────────────────
COMPONENT_LIBRARY_MCP_URL=http://localhost:8001/sse
RESUME_PARSER_MCP_URL=http://localhost:8002/sse
GITHUB_MCP_URL=http://localhost:8003/sse

# ── Pipeline config ───────────────────────────────────────────
PROFESSION_MATCH_THRESHOLD=0.75
MAX_COPY_RETRIES=2
PROFILE_TOKEN_THRESHOLD=1500
MAX_COMPONENTS=8

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_USER_HOURLY=10
RATE_LIMIT_PER_USER_DAILY=50
RATE_LIMIT_PER_IP_HOURLY=20
RATE_LIMIT_GLOBAL_CONCURRENT=500

# ── Eval ──────────────────────────────────────────────────────
EVAL_ACCURACY_THRESHOLD=4.0
EVAL_SCHEMA_PASS_THRESHOLD=0.98

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_VERSION=v1
